{
  "model_name": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
  "resume_checkpoint": "",
  "random_seed": 42,
  "max_epochs": 3,
  "per_device_batch_size": 2,
  "learning_rate": 0.00002,
  "weight_decay": 0.01,
  "max_length": 256,
  "dataloader_num_workers": 2,
  "log_every_n_steps": 1,
  "gradient_clip_val": 1.0,
  "lightning_precision": "32-true",
  "model_torch_dtype": "bfloat16",
  "fsdp_sharding_strategy": "FULL_SHARD",
  "fsdp_param_dtype": "bfloat16",
  "fsdp_reduce_dtype": "float32",
  "fsdp_buffer_dtype": "float32",
  "fsdp_use_activation_checkpointing": true,
  "fsdp_use_cpu_offload": false,
  "fsdp_cast_forward_inputs": true,
  "float32_matmul_precision": "high",
  "hf_home": "/tmp/huggingface",
  "transformers_cache": "/tmp/huggingface/transformers",
  "tokenizers_parallelism": "false",
  "pytorch_cuda_alloc_conf": "expandable_segments:True",
  "hf_hub_disable_xet": "true",
  "checkpoints_to_keep": 3,
  "ray_storage_path": "/Volumes/mycatalog/myschema/air_checkpoints/ray_results",
  "ray_cluster_wait_seconds": 900,
  "ray_cluster_poll_seconds": 10,
  "ray_train_run_name": "tinyllama-fsdp-24node",
  "ray_max_failures": 1
}
